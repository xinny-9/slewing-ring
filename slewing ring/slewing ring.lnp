--cpu Cortex-M3
"slewing ring\startup_stm32f103xb.o"
"slewing ring\main.o"
"slewing ring\gpio.o"
"slewing ring\tim.o"
"slewing ring\usart.o"
"slewing ring\stm32f1xx_it.o"
"slewing ring\stm32f1xx_hal_msp.o"
"slewing ring\stm32f1xx_hal_gpio_ex.o"
"slewing ring\stm32f1xx_hal_tim.o"
"slewing ring\stm32f1xx_hal_tim_ex.o"
"slewing ring\stm32f1xx_hal.o"
"slewing ring\stm32f1xx_hal_rcc.o"
"slewing ring\stm32f1xx_hal_rcc_ex.o"
"slewing ring\stm32f1xx_hal_gpio.o"
"slewing ring\stm32f1xx_hal_dma.o"
"slewing ring\stm32f1xx_hal_cortex.o"
"slewing ring\stm32f1xx_hal_pwr.o"
"slewing ring\stm32f1xx_hal_flash.o"
"slewing ring\stm32f1xx_hal_flash_ex.o"
"slewing ring\stm32f1xx_hal_exti.o"
"slewing ring\stm32f1xx_hal_uart.o"
"slewing ring\system_stm32f1xx.o"
"slewing ring\serial_servo.o"
"slewing ring\serial_servo_debug_cli.o"
"slewing ring\serial_servo_hal.o"
"slewing ring\control.o"
"slewing ring\data.o"
--library_type=microlib --strict --scatter "slewing ring\slewing ring.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "slewing ring.map" -o "slewing ring\slewing ring.axf"